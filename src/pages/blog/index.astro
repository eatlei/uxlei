---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PortfolioRail from "@/components/PortfolioRail.astro";
import { formatDate, withBase } from "@/utils";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.pubDate - +a.data.pubDate,
);
---

<BaseLayout title="Blog" description="随笔与思考">
  <section class="portfolio-shell blog-directory" aria-labelledby="blog-title">
    <PortfolioRail active="blog" />

    <main class="portfolio-main">
      <header class="blog-directory-hero">
        <p class="portfolio-kicker" id="blog-title">BLOG</p>
      </header>

      {posts.length > 0 ? (
        <ol class="portfolio-post-list blog-post-list">
          {posts.map((post) => (
            <li>
              <a href={withBase(`/blog/${post.id}`)}>
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                <span>{post.data.title}</span>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="portfolio-empty">还没有文章。</p>
      )}
    </main>
  </section>
</BaseLayout>
