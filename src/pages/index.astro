---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PortfolioRail from "@/components/PortfolioRail.astro";
import { formatDate, withBase } from "@/utils";

const works = (await getCollection("work", ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate)
  .slice(0, 5);

const featuredWorks = [
  works.find((work) => work.id === "tiktok"),
].filter(Boolean);
---

<BaseLayout>
  <section class="portfolio-shell home-index" aria-labelledby="home-title">
    <PortfolioRail active="index" />

    <main class="portfolio-main">
      <header class="home-intro">
        <p class="portfolio-kicker">INDEX</p>
        <h1 id="home-title">
          设计是我的工作，写字是我的方式。
        </h1>
        <p>
          Focus on product strategy, interaction design,<br />
          growth systems and operational design.
        </p>
      </header>

      <section class="home-board" aria-label="Index highlights">
        <div class="home-writing">
          <div class="portfolio-section-head">
            <h2>Blog</h2>
            <a href={withBase("/blog")}>All posts</a>
          </div>

          <ol class="portfolio-post-list">
            {posts.map((post) => (
              <li>
                <a href={withBase(`/blog/${post.id}`)}>
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                  <span>{post.data.title}</span>
                </a>
              </li>
            ))}
          </ol>

          {posts.length === 0 && (
            <p class="portfolio-empty">还没有文章。</p>
          )}
        </div>

        <div class="home-showcase">
          <div class="portfolio-section-head">
            <h2>Work</h2>
            <a href={withBase("/work")}>All work</a>
          </div>

          <div class="home-gallery" aria-label="Selected work images">
          {featuredWorks.map((work, index) => (
            <a
              href={withBase(`/work/${work.id}`)}
              class={`home-gallery-card home-gallery-card-${index + 1}`}
            >
              <figure>
                {work.data.cover ? (
                  <img src={work.data.cover} alt={`${work.data.title} cover`} loading="lazy" />
                ) : (
                  <span>{work.data.title.slice(0, 2)}</span>
                )}
                <figcaption>
                  <span>{work.data.title}</span>
                  <small>{work.data.locked ? "在职 · 暂不公开" : work.data.year}</small>
                </figcaption>
              </figure>
            </a>
          ))}
          </div>
        </div>
      </section>
    </main>
  </section>
</BaseLayout>
