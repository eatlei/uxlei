---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PortfolioRail from "@/components/PortfolioRail.astro";
---

<BaseLayout title="Info" description="关于 Leon">
  <section class="portfolio-shell info-directory" aria-labelledby="info-title">
    <PortfolioRail active="info" />

    <main class="portfolio-main">
      <header class="home-intro">
        <p class="portfolio-kicker">INFO</p>
        <h1 id="info-title">我是 Leon，一名设计师。</h1>
        <p>
          专注产品策略、交互设计、增长系统与运营设计。<br />
          做过百度、美团、字节跳动的产品与运营设计。
        </p>
      </header>
    </main>
  </section>
</BaseLayout>
