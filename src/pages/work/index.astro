---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PortfolioRail from "@/components/PortfolioRail.astro";
import { withBase } from "@/utils";

const yearScore = (year: string | number) => {
  const text = String(year);
  if (text.includes("进行中")) return 9999;
  const years = text.match(/\d{4}/g)?.map(Number) ?? [0];
  return Math.max(...years);
};

const works = (await getCollection("work", ({ data }) => !data.draft)).sort(
  (a, b) => yearScore(b.data.year) - yearScore(a.data.year),
);

const postAi = works.filter((work) => work.data.era === "post-ai");
const preAi = works.filter((work) => work.data.era !== "post-ai");
const groups = [
  { id: "post-ai", eyebrow: "AI 已接入工作之后", label: "After AI", items: postAi },
  { id: "pre-ai", eyebrow: "AI 普及之前的产品与运营设计", label: "Before AI", items: preAi },
].filter((group) => group.items.length > 0);
---

<BaseLayout title="Work" description="完整项目列表">
  <section class="portfolio-shell work-directory" aria-labelledby="work-title">
    <PortfolioRail active="work" />

    <main class="portfolio-main">
      <header class="work-directory-hero">
        <p class="portfolio-kicker">WORK</p>
        <h1 id="work-title">完整项目列表</h1>
        <p>
          从百度、美团到字节跳动，把增长链路、运营活动和产品体验拆成可复用的方法。
        </p>
      </header>

      <div class="work-projects">
        {groups.map((group, groupIndex) => (
          <>
          {groupIndex === 1 && (
            <div class="work-ai-rule" aria-label="The AI divide — work after AI above, before AI below.">
              <span>THE AI DIVIDE</span>
            </div>
          )}
          <section id={group.id} class="work-era-block" aria-labelledby={`${group.id}-title`}>
            <div class="work-era-label">
              <span id={`${group.id}-title`}>{group.label}</span>
              <p>{group.eyebrow}</p>
            </div>

            <div class="work-era-items">
              {group.items.map((work, index) => (
                <a
                  href={withBase(`/work/${work.id}`)}
                  class={`work-project-row work-project-row-${index + 1}`}
                >
                  <figure>
                    {work.data.cover ? (
                      <img src={work.data.cover} alt={`${work.data.title} cover`} loading="lazy" />
                    ) : (
                      <span>{work.data.title.slice(0, 2)}</span>
                    )}
                  </figure>

                  <div class="work-project-copy">
                    <p class="work-project-meta">
                      <span>{work.data.year}</span>
                      <span>{work.data.role ?? "Design"}</span>
                      {work.data.locked && <span class="work-lock-tag">在职 · 暂不公开</span>}
                    </p>
                    <h2 id={`${group.id}-title-${work.id}`}>{work.data.title}</h2>
                    <p>{work.data.summary}</p>
                    {work.data.tags.length > 0 && (
                      <ul aria-label={`${work.data.title} tags`}>
                        {work.data.tags.map((tag) => (
                          <li>{tag}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </section>
          </>
        ))}
      </div>
    </main>
  </section>
</BaseLayout>
