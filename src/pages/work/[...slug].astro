---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PortfolioRail from "@/components/PortfolioRail.astro";
import { withBase } from "@/utils";

export async function getStaticPaths() {
  const works = await getCollection("work", ({ data }) => !data.draft);
  return works.map((w) => ({ params: { slug: w.id }, props: { entry: w } }));
}

const { entry } = Astro.props;
const { title, summary, role, year, client, cover, tags, metrics, locked, lockedNote } =
  entry.data;
const rendered = locked ? null : await render(entry);
const Content = rendered?.Content;
const lockMessage =
  lockedNote ?? "该项目为在职期间的工作，出于保密要求暂不公开。";
const meta = [year, role, client].filter(Boolean).join("  ·  ");
---

<BaseLayout title={title} description={summary}>
  <section class="portfolio-shell work-article" aria-labelledby="article-title">
    <PortfolioRail active="work" />

    <main class="portfolio-main">
      <a class="portfolio-kicker article-back" href={withBase("/work")}>← WORK</a>

      <article class="article-page">
        <header class="article-head">
          <p class="article-meta">{meta}</p>
          <h1 id="article-title">{title}</h1>
        </header>

        {locked ? (
          <div class="article-locked">
            <p class="article-locked-eyebrow">在职 · 暂不公开</p>
            <p class="article-lede">{lockMessage}</p>
            <p class="article-locked-contact">
              如需进一步了解，欢迎邮件交流 →{" "}
              <a href="mailto:hi@thisleon.com">hi@thisleon.com</a>
            </p>
          </div>
        ) : (
          <>
            <p class="article-lede">{summary}</p>

            {tags.length > 0 && (
              <ul class="article-tags" aria-label="Tags">
                {tags.map((t) => <li>{t}</li>)}
              </ul>
            )}

            {cover && (
              <figure class="article-cover">
                <img src={cover} alt={`${title} 案例封面`} loading="eager" decoding="async" />
              </figure>
            )}

            {metrics.length > 0 && (
              <ul class="article-metrics" aria-label="Key metrics">
                {metrics.map((m) => (
                  <li>
                    <span class="article-metric-value">{m.value}</span>
                    <span class="article-metric-label">{m.label}</span>
                  </li>
                ))}
              </ul>
            )}

            <div class="prose-page">
              <Content />
            </div>
          </>
        )}
      </article>
    </main>
  </section>
</BaseLayout>
