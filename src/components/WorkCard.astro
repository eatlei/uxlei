---
import { withBase } from "@/utils";

const { entry } = Astro.props;
const w = entry;
const index = Astro.props.index ?? 0;
const indexLabel = String(index + 1).padStart(2, "0");
---

<a
  href={withBase(`/work/${w.id}`)}
  class="work-card group"
  data-case={w.id}
  data-era={w.data.era}
  data-index={indexLabel}
  style={`--card-index:${index + 1}`}
>
  <div class="work-card-media relative mb-6 aspect-[16/10] overflow-hidden rounded-xl bg-[color:var(--rule)]">
    <span class="work-card-index" data-index={indexLabel} aria-hidden="true"></span>
    <span class="work-card-corner work-card-corner-a" aria-hidden="true"></span>
    <span class="work-card-corner work-card-corner-b" aria-hidden="true"></span>
    {w.data.cover ? (
      <img src={w.data.cover} alt={w.data.title} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.035]" />
    ) : (
      <div class="absolute inset-0 flex items-center justify-center font-display text-5xl text-[color:var(--muted)]">
        {w.data.title.slice(0, 2)}
      </div>
    )}
  </div>
  <div class="work-card-body flex items-start justify-between gap-4">
    <h2 class="font-display text-3xl leading-tight transition-colors group-hover:text-[color:var(--color-accent)]">
      {w.data.title}
    </h2>
    <span class="shrink-0 pt-2 font-mono text-xs text-[color:var(--muted)]">{w.data.year}</span>
  </div>
  <p class="mt-3 max-w-xl text-[color:var(--muted)]">{w.data.summary}</p>
  {w.data.tags.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-2 text-xs">
      {w.data.tags.map((t) => (
        <li class="rounded-full border border-[color:var(--rule)] px-2.5 py-1 text-[color:var(--muted)]">{t}</li>
      ))}
    </ul>
  )}
</a>
