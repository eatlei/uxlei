---
import { NAV, SITE } from "@/consts";
import ThemeToggle from "@/components/ThemeToggle.astro";

const path = Astro.url.pathname.replace(import.meta.env.BASE_URL, "/").replace(/^\/+/, "/");
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header class="border-b border-[color:var(--rule)]">
  <div class="site-header-inner mx-auto flex max-w-6xl items-center justify-between px-3 py-5 sm:px-6">
    <a href={`${base}/`} class="font-display text-lg tracking-tight sm:text-xl">
      {SITE.name}<span class="text-[color:var(--color-accent)]">.</span>
    </a>

    <nav class="site-nav flex items-center gap-0 text-xs sm:gap-0.5 sm:text-sm">
      {
        NAV.map((item) => {
          const href = `${base}${item.href}`;
          const active = path === item.href || path.startsWith(item.href + "/");
          return (
            <a
              href={href}
              class:list={[
                "px-1.5 py-1.5 rounded-full transition-colors sm:px-3",
                active
                  ? "text-[color:var(--fg)]"
                  : "text-[color:var(--muted)] hover:text-[color:var(--fg)]",
              ]}
            >
              {item.label}
              {active && (
                <span class="ml-1.5 inline-block h-1 w-1 rounded-full bg-[color:var(--color-accent)] align-middle"></span>
              )}
            </a>
          );
        })
      }
      <span class="mx-0.5 h-4 w-px bg-[color:var(--rule)] sm:mx-2"></span>
      <ThemeToggle />
    </nav>
  </div>
</header>
